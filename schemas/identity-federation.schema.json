{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wellmanifest.dev/schemas/auth-lifecycle/identity-federation/v1",
  "title": "Wellmanifest Auth Lifecycle — identity federation profile",
  "description": "Identity plane and partner connector declarations. See docs/FEDERATION.md. Does not issue AuthZ grants.",
  "x-home": "wellmanifest",
  "x-shape": "domain_pack",
  "oneOf": [
    {"$ref": "#/$defs/identityPlane"},
    {"$ref": "#/$defs/connector"}
  ],
  "$defs": {
    "httpsUrl": {"type": "string", "pattern": "^https://[a-z0-9.-]+(:[0-9]+)?(/.*)?$"},
    "grant": {
      "type": "string",
      "enum": [
        "authorization_code",
        "refresh_token",
        "urn:ietf:params:oauth:grant-type:device_code",
        "urn:ietf:params:oauth:grant-type:token-exchange"
      ],
      "description": "Closed grant set. password and implicit are forbidden (AUTHN-FED-002)."
    },
    "authKind": {
      "type": "string",
      "enum": [
        "oauth2-authorization-code-pkce",
        "github-app-installation",
        "atlassian-oauth2-3lo",
        "scoped-api-token"
      ]
    },
    "identityPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "planeId", "issuer", "deployment", "protocol", "sessions", "errors", "audit"],
      "properties": {
        "schema": {"const": "wellmanifest.auth-lifecycle/identity-plane/v1"},
        "planeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,80}$"},
        "issuer": {"$ref": "#/$defs/httpsUrl"},
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dedicatedProcess", "dedicatedDataStore", "roleFromRequestHeaders", "trustedProxies"],
          "properties": {
            "dedicatedProcess": {"const": true},
            "dedicatedDataStore": {"const": true},
            "roleFromRequestHeaders": {"const": false},
            "trustedProxies": {"type": "array", "items": {"type": "string"}}
          }
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["oidcDiscovery", "grantTypes", "pkceMethods", "signingAlgorithms", "problemDetails"],
          "properties": {
            "oidcDiscovery": {"const": "/.well-known/openid-configuration"},
            "grantTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/grant"}},
            "pkceMethods": {"type": "array", "const": ["S256"]},
            "signingAlgorithms": {"type": "array", "minItems": 1, "items": {"enum": ["EdDSA", "ES256"]}},
            "dpop": {"type": "boolean"},
            "problemDetails": {"const": true}
          }
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cookieScope", "sameSite", "httpOnly", "absoluteSeconds", "idleSeconds"],
          "properties": {
            "cookieScope": {"const": "host-only"},
            "sameSite": {"enum": ["Lax", "Strict"]},
            "httpOnly": {"const": true},
            "absoluteSeconds": {"type": "integer", "minimum": 300, "maximum": 2592000},
            "idleSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mediaType", "codes", "traceparent"],
          "properties": {
            "mediaType": {"const": "application/problem+json"},
            "codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}},
            "traceparent": {"const": true}
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failures", "secretsRedacted"],
          "properties": {
            "failures": {"const": true},
            "secretsRedacted": {"const": true}
          }
        },
        "enterprise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upstreamOidc": {"type": "boolean"},
            "saml": {"type": "boolean"},
            "scim": {"type": "boolean"},
            "webauthn": {"type": "boolean"}
          }
        },
        "connectors": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"}}
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "connectorId", "partner", "authKind", "scopes", "custody", "webhooks"],
      "properties": {
        "schema": {"const": "wellmanifest.auth-lifecycle/connector/v1"},
        "connectorId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"},
        "partner": {"type": "string", "minLength": 2, "maxLength": 80},
        "authKind": {"$ref": "#/$defs/authKind"},
        "baseUrlConfigurable": {"type": "boolean"},
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authorize": {"$ref": "#/$defs/httpsUrl"},
            "token": {"$ref": "#/$defs/httpsUrl"},
            "api": {"$ref": "#/$defs/httpsUrl"}
          }
        },
        "scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "custody": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vault", "exportRefreshToken", "consumerAccess"],
          "properties": {
            "vault": {"const": "envelope-encrypted"},
            "exportRefreshToken": {"const": false},
            "consumerAccess": {"enum": ["token-exchange", "broker-proxy"]},
            "maxConsumerTokenSeconds": {"type": "integer", "minimum": 60, "maximum": 3600}
          }
        },
        "webhooks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported"],
          "properties": {
            "supported": {"type": "boolean"},
            "verification": {"enum": ["hmac-sha256", "jwt", "shared-token"]}
          },
          "if": {"properties": {"supported": {"const": true}}},
          "then": {"required": ["verification"]}
        }
      }
    }
  }
}
